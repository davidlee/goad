import { Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "goad spike";
    preferred-width: 360px;
    preferred-height: 160px;
    in-out property <string> status: "waiting";
    callback picked(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text { text: "Fill in your interstitial journal?"; font-size: 16px; }
        Text { text: root.status; color: grey; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Yeah"; clicked => { root.picked("yes"); } }
            Button { text: "Nah"; clicked => { root.picked("no"); } }
        }
    }
}
