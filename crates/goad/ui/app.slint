import { Button, CheckBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";

// **`Date` and `Time` are re-exported so Rust can name them**, and for no
// other reason: `instant.rs`'s `compose` takes a pair of these and
// `decompose` answers one. They are library structs
// (`std-widgets.slint`), not builtins, and an **import alone is not an
// export** — measured four ways against the generated `app.rs`, and neither
// is emitted without this line. It declares no control and reads no slot, so
// the rule below still holds. PHASE-07 re-measures whether it is still
// needed once `FieldValue` carries `date` and `time` of its own.
export { Date, Time } from "std-widgets.slint";

// Registers the family so `font-family` below can name it. The path is
// relative to this file, and the compiler embeds the face in the binary —
// there is no runtime lookup and no fontconfig dependency for this family, so
// the window draws the same text on a machine that has never heard of Inter.
import "../../../assets/Inter.ttf";
import "../../../assets/Geist.ttf";

// **Two channels, one field** (design.md §5.1, §5.2). `FieldRow` is
// *structure* — what the backend declared — and is repeated over, so writing
// it destroys every element beneath it. `FieldValue` is *state* — what the
// draft and the person between them make of the field — and nothing repeats
// over it, so it is rewritten whole on every present and destroys nothing.
//
// `slot` is the join: a field's index into `values`. It is held by `glass.rs`
// building both models in one pass rather than by two numberings kept in step
// (§5.5 I-B), and `values` is flat across the whole presentation, so the
// numbering runs across options and blocks alike.
//
// The kind discriminant selects which slot of `FieldValue` is meaningful. All
// five are declared because the mapping from the protocol's field kinds must
// be total; this renderer draws two of them so far — `boolean` and `text` —
// and each later phase adds one control and the fields it reads. `FieldRow`'s `slider` / `minimum` /
// `maximum` / `step` / `alternatives` and `FieldValue`'s `date` / `time` are
// **not** here yet: nothing is declared before a control reads it.
export enum Kind { boolean, text, number, choice, datetime }
export struct FieldRow { id: string, label: string, kind: Kind, slot: int }
export struct FieldValue { checked: bool, text: string, number: float, index: int }
// `heading: ""` is an **untitled** block, not a missing one — an ungrouped
// field must not be drawn under a heading that does not claim it.
export struct FieldBlock { heading: string, fields: [FieldRow] }
export struct OptionRow { id: string, label: string, view: string, blocks: [FieldBlock] }

// **One edit, typed.** `install.rs`'s `edited` closure maps this straight to a
// `draft.rs::Reported` and does nothing else with it — no parse, no fallback,
// no refusal — because a Slint callback cannot mint an `AlternativeId` and
// cannot know the last representable number a numeric field held. Both are
// interpreted where the retained presentation is (design.md §5.2, §7 D25).
//
// `kind` carries the **protocol** kind and never the control, so
// `draft.rs::submitted` stays the single application of `R-57` (§5.5 I-C), and
// the discriminant selects which of the remaining slots is meaningful. `date`
// and `time` are **not** here yet, for the same reason `FieldValue`'s are not:
// nothing is declared before a control writes it. PHASE-07 adds them with the
// pickers.
export struct FieldEdit { kind: Kind, checked: bool, text: string, number: float, index: int }

export enum WindowMode { prompt, diagnostic }

// **The middle tone of the ramp, and the corner it is always drawn with.**
// Three surfaces are this same object — the prompt's header, an option, and
// the diagnostic report — so it is one declaration rather than three that have
// to be kept in step. Tone is the whole of the treatment; no border at any
// level. See `PromptWindow.background` for where the ramp's steps come from.
component Card inherits Rectangle {
  background: Palette.background;
  border-radius: 8px;
}

// **The top of the ramp**: raised off a card rather than outlined on it.
// Neither level needs an edge once the tones do the work. Both panes use it —
// a block of fields on the prompt side, the report on the diagnostic one — so
// text a person actually reads sits on the same surface, and at the same
// inset, whichever pane is up.
component Panel inherits Rectangle {
  background: Palette.background.brighter(0.30);
  border-radius: 6px;
}

export component PromptWindow inherits Window {
  in property <WindowMode> mode;

  // prompt mode
  in property <string> heading;
  in property <styled-text> body;        // the Slint type is `styled-text` (F-11)
  in property <[OptionRow]> options;     // structure: written only when the view changes
  in property <[FieldValue]> values;     // state: rewritten every present, indexed by `slot`
  in property <int> epoch;               // bumped every present; the guard's only trigger
  in property <bool> body-degraded;
  in property <bool> busy;               // an exchange is in flight; controls disabled

  // **Instruments, in production markup deliberately** (design.md §7 D15). A
  // test-only copy of the field markup would be a parallel implementation of
  // the thing under test: what a case measured would be the copy's element
  // lifetimes rather than this window's.
  //
  // `inits` counts element constructions — an element that is destroyed and
  // recreated runs `init` again, and one written in place does not, which is
  // the only way element identity is observable at all
  // (`docs/memory/a-present-destroys-the-widget-it-writes.md`). `reasserts`
  // counts the guards that found a difference and wrote it back, which is how
  // *the present disturbed nothing* is told from *the present corrected the
  // widget*.
  //
  // A guard that never ran would leave `reasserts` at rest and look like the
  // first of those. What tells them apart is the negative control the plan
  // requires before the red is believed: removing the difference test makes
  // the counter move, which it cannot do unless the handler fires
  // (`plan.md` PHASE-01/VT-5).
  out property <int> inits;
  out property <int> reasserts;

  // either mode
  in property <string> notice;           // back-pressure, host-authored; "" = none

  // diagnostic mode
  in property <[string]> diagnostic-lines;   // ordered, escaped and bounded in Rust
  in property <string> next-check;           // the standing schedule's line, not a diagnostic row; "" = none yet

  callback chosen(string, string);       // (view token, OptionId.as_str())
  callback edited(string, string, string, FieldEdit);  // view, option, field, edit
  callback close-diagnostics();          // leave diagnostic mode

  title: root.mode == WindowMode.prompt ? "goad" : "goad — diagnostics";

  // The width is the host's, not the backend's. Every string on this surface
  // is backend-authored and unbounded, so a width derived from content is a
  // width one long label decides.
  //
  // **These two numbers are the whole of it.** Measured: the window asks for
  // 420px with no option on it, with a 420-character option label, and with a
  // 450-character checkbox label alike — nothing propagates a width upward
  // past the scroller, not even a control's own minimum, so `min-width` is
  // reached by nothing this markup can draw and is a floor against a future
  // change rather than against a backend. `tests/renderer/sizing.rs` records
  // the measurement and why no case asserts it.
  // Named once, on the root: every `Text`, `CheckBox` and `Button` below
  // inherits it, and the widget library's own faces come with it.

  preferred-width: 420px;
  min-width: 340px;

  default-font-family: "Geist";

  // **The tonal ramp, in one place.** Three steps — measured 22 / 28 / 36 on
  // this style's dark ground — and nesting is what a step means: the frame is
  // the ground, an option's card sits on it, and a block's panel sits on the
  // card.
  //
  // The step is 30%, not the 12% first tried. 12% is the right *ratio* and the
  // wrong *difference*: at this end of the scale it is three levels out of 255
  // and the three surfaces read as one flat sheet. Measured on screen, both
  // times, rather than argued about.
  //
  // Anchored *downwards* from the style's own ground rather than upwards from
  // it. `Palette.background` stays the card — the tone a person looks at most
  // — and the frame is darkened under it, which keeps the top of the ramp
  // close to the style's ground instead of a third brighter than it. Every
  // tone is derived from the one token, so a style with a different ground
  // still gets a ramp rather than three values that happen to suit this one.
  background: Palette.background.darker(0.30);

  // The two insets of the ramp, named because a third element has to *align*
  // with them. A header sitting at the window's own padding starts left of
  // every word in the form below it; adding the two together is what puts its
  // text in the same column, and derives that rather than restating it as a
  // number that can drift out of step with either.
  private property <length> card-inset: 12px;
  private property <length> panel-inset: 10px;

  VerticalLayout {
    if root.mode == WindowMode.prompt: VerticalLayout {
      padding: 18px;
      spacing: 18px;

      // The header is a card too, on the same middle tone as an option's:
      // three surfaces on the ramp, not two plus some loose text. Its text
      // aligns with the form's rather than sitting left of it — see
      // `card-inset`.
      Card {
        // Title and body are one unit and are spaced as one. The 18px on the
        // layout above separates *them* from the options; 4px here keeps a
        // body line against the title it explains rather than halfway to the
        // first control.
        VerticalLayout {
        padding-left: root.card-inset + root.panel-inset;
        padding-right: root.card-inset + root.panel-inset;
        padding-top: root.card-inset;
        padding-bottom: root.card-inset;
        spacing: 4px;
        Text {
          text: root.heading;
          font-size: 17px;
          font-weight: 600;
          wrap: word-wrap;
        }
        StyledText {
          text: root.body;
          // E-5: the link is handled and ignored. This slice opens no URL, and an
          // unhandled callback is not the same statement as a handled one.
          link-clicked(link) => { }
        }
        if root.body-degraded: Text {
          text: "shown as plain text";
          font-size: 11px;
          color: Palette.border;
        }
        }
      }

      scroller := ScrollView {
        // **The window's preferred height comes from here.** A `ScrollView`
        // propagates no preferred size from its content — measured at 007's
        // audit as a window 50×65 for every content shape, at which one of two
        // option buttons is reachable. Binding the height to the content's own
        // preferred height restores the propagation the scroller breaks, and
        // the `min` is what keeps a long form from asking for a window taller
        // than the screen: past the cap the scroller does its job.
        //
        // **`min-height`, not `height`.** A fixed height leaves the window's
        // slack to be shared out among the *other* children, and a tiling
        // compositor hands this window a whole column: the title went to the
        // top of the screen, the body a third of the way down and the form to
        // the foot of it. A minimum states the same preferred size and lets
        // the scroller absorb the rest, so the content stays one block at the
        // top however tall the window is made.
        min-height: min(stack.preferred-height, 560px);

        stack := VerticalLayout {
          accessible-role: list;
          accessible-label: "options";
          accessible-item-count: root.options.length;

          // Pack to the top. Without it the list distributes the window's slack
          // between the options, so an option with no fields is flung to the
          // foot of the window and the gap between two options says more than
          // the gap between an option and the fields it carries.
          alignment: start;
          spacing: 16px;

          // **One card per option**, and the card is what binds an option to
          // the fields it carries. With the control drawn *above* its fields an
          // indent hung from a parent; with the control below — fill, then
          // commit — an indent hangs from nothing, and the two controls of two
          // options read as a pair with nothing saying which one the fields in
          // between belong to.
          //
          // Unconditional, so that an option with fields and an option with
          // only a control are the same kind of thing on the screen: one card,
          // one control, whatever else it carries. Tone is the whole of the
          // treatment — no border at either level.
          for option[index] in root.options: Card {
            VerticalLayout {
              padding: root.card-inset;
              spacing: 10px;
              // Without this the layout distributes whatever slack it is given
              // *between* the fields and the control, and the spacing stops
              // meaning anything: a tall window pushes the members of one block
              // further apart than two blocks are. Packing to the top is what
              // makes the spacing a statement about grouping rather than a
              // minimum.
              alignment: start;

              // Guarded, so an option with no fields adds no element at all:
              // absent, not empty. The guard is what makes this per-**option**
              // rather than per-block — a container produced by the `for` below
              // would exist once per block and carry `option.id` that many times.
              if option.blocks.length > 0: VerticalLayout {
                // A role is mandatory, not decoration: the compiler admits an
                // accessibility property only on an element whose role is bound.
                // `groupbox` is a labelled group of controls, which is what this
                // is. The label is not an identity and no test selects on it.
                accessible-role: groupbox;
                accessible-description: option.id;
                accessible-label: option.label;

                spacing: 10px;
                alignment: start;

                // A **panel per block**: the border is what says which fields a
                // heading covers, and it says it without depending on the
                // reader measuring two gaps against each other.
                //
                // Drawn here rather than taken from `std-widgets`' `GroupBox`,
                // for two reasons. Fluent's `GroupBox` draws no border at all —
                // it is a bold title and some padding
                // (`fluent/groupbox.slint`), so it would not do the job. And it
                // binds `accessible-role: groupbox`, which would put one such
                // element per *block* in a tree where exactly one per **option**
                // is asserted, and would put its title in the scope
                // `labels_in_option` reads (`tests/renderer/tree.rs`).
                //
                // An untitled block is still a panel. `heading: ""` is an
                // untitled block, not a missing one, and the fields it carries
                // are as much a block as any other.
                for block in option.blocks: Panel {
                  VerticalLayout {
                    padding: root.panel-inset;
                    // Same reason as the container's, one level down: a heading
                    // must sit against the fields it covers, not float halfway
                    // to the next one.
                    alignment: start;
                    // **The heading's gap is its own, and larger than a field's.**
                    // With one spacing for both, a heading sat exactly as far
                    // from the field it covers as that field sat from the next,
                    // so the gap said nothing about which fields the heading
                    // claimed. This is the gap between the heading and the
                    // block; the fields keep their own, tighter one below.
                    spacing: 9px;

                    if block.heading != "": Text {
                      text: block.heading;
                      font-size: 14px;
                      font-weight: 400;
                      letter-spacing: 1.2px;
                      // Transparentised rather than darkened: it blends towards
                      // whatever is behind, so the same declaration mutes a
                      // near-white foreground on a dark ground and a near-black
                      // one on a light ground. `darker()` would only ever go one
                      // way and would be wrong in half the themes.
                      color: Palette.foreground.transparentize(0.35);
                    }

                    // The fields are their own run, spaced tighter than the
                    // heading is from them.
                    VerticalLayout {
                      alignment: start;
                      spacing: 4px;

                      // **One `if` per drawn kind, and the row is the
                      // discriminant.** `FieldRow.kind` is written by
                      // `glass.rs::markup_kind` off the drawn field, which is
                      // total over `DrawnKind` — so a kind no arm below draws
                      // is a compile error there rather than a field that
                      // renders as nothing here. The kinds with no arm yet are
                      // reported undrawn and never become a `FieldRow` at all
                      // (`view_model::drawn_form`): `datetime` PHASE-07,
                      // `number` PHASE-08, `choice` PHASE-09.
                      for field in block.fields: VerticalLayout {
                        alignment: start;
                        spacing: 2px;

                        // The `HorizontalLayout` is what stops the control
                        // filling the block's width. A `CheckBox` given the whole
                        // row draws its focus ring around the whole row, so a
                        // focused field reads as a banner across the window
                        // rather than as the box and label it is.
                        if field.kind == Kind.boolean: HorizontalLayout {
                          alignment: start;
                          CheckBox {
                            text: field.label;
                            // **The value channel is the authority.** The widget
                            // flips itself on click so the feedback is
                            // immediate; the next present rewrites this slot,
                            // which is what corrects a click the host dropped
                            // (design.md §5.4).
                            checked: root.values[field.slot].checked;
                            enabled: !root.busy;
                            accessible-description: field.id;
                            init => { root.inits += 1; }
                            // **The guard.** A click *assigns* `checked`, which
                            // removes the binding above permanently — that is
                            // what a self-assigning widget does — so the epoch
                            // is what brings the widget back to the channel. It
                            // compares itself against its own slot and writes
                            // itself back only where they differ, and writing
                            // nothing where they agree is the whole point: it is
                            // what lets a caret, a selection or a drag survive a
                            // present (§5.2's comparand table, §7 D8).
                            property <int> tick: root.epoch;
                            changed tick => {
                              if (self.checked != root.values[field.slot].checked) {
                                self.checked = root.values[field.slot].checked;
                                root.reasserts += 1;
                              }
                            }
                            // **The literal names the control's own kind, not
                            // the row's.** `field.kind` would make the report
                            // agree with the row by construction, and
                            // `interpret`'s third `None` case — a report whose
                            // variant is not the drawn field's kind — could then
                            // never fire. A `CheckBox` reports a boolean because
                            // that is what a `CheckBox` is (design.md §5.2).
                            toggled => {
                              root.edited(option.view, option.id, field.id, {
                                kind: Kind.boolean,
                                checked: self.checked,
                              });
                            }
                          }
                        }

                        // **A `LineEdit` carries no label of its own**, so the
                        // one the backend authored is drawn above it rather than
                        // as placeholder text, which disappears the moment
                        // somebody types. `accessible-label` carries the same
                        // string, so what is announced and what is drawn are one
                        // value; `accessible-description` stays the id, which is
                        // what every renderer case selects on
                        // (`harness::field_described`).
                        if field.kind == Kind.text: Text {
                          text: field.label;
                          color: Palette.foreground.transparentize(0.20);
                        }
                        if field.kind == Kind.text: LineEdit {
                          // **The value channel is the authority**, exactly as
                          // it is for the box above: the widget writes itself as
                          // a person types so the feedback is immediate, and the
                          // next present rewrites this slot.
                          text: root.values[field.slot].text;
                          enabled: !root.busy;
                          accessible-label: field.label;
                          accessible-description: field.id;
                          init => { root.inits += 1; }
                          // **The guard, comparing string against string.**
                          // Typing *assigns* `text`, which removes the binding
                          // above permanently, so the epoch is what brings the
                          // widget back to the channel. String against string is
                          // an identity here — the host holds the text a person
                          // typed — and writing nothing where they agree is what
                          // lets the caret survive a present (§5.2's comparand
                          // table, §7 D8).
                          property <int> tick: root.epoch;
                          changed tick => {
                            if (self.text != root.values[field.slot].text) {
                              self.text = root.values[field.slot].text;
                              root.reasserts += 1;
                            }
                          }
                          // The literal names the control's own kind, for the
                          // reason the `CheckBox`'s does. `edited` fires per
                          // keystroke and `install.rs` routes it through the
                          // debounce; nothing here knows that, and nothing here
                          // should.
                          edited => {
                            root.edited(option.view, option.id, field.id, {
                              kind: Kind.text,
                              text: self.text,
                            });
                          }
                        }
                      }
                    }
                  }
                }
              }

              // The control that answers, at the foot of what it carries. It
              // sits **outside** the field container deliberately:
              // `labels_in_option` (`tests/renderer/tree.rs`) scopes by the
              // groupbox role precisely so that everything in scope was drawn
              // by the field markup, and a Button inside would put its own
              // internal `Text` in that scope.
              //
              // The HorizontalLayout is what stops the control stretching to
              // the window's width, where it reads as a banner rather than as
              // the thing you press.
              HorizontalLayout {
                alignment: start;
                Button {
                  text: option.label;
                  enabled: !root.busy;
                  // The identity the tests select on: R-14 permits two options
                  // to share a label (D10, T-E). It is not unique in the tree —
                  // the field container answers to the same description — so a
                  // query for the control filters by type as well.
                  accessible-description: option.id;
                  accessible-item-index: index;
                  clicked => { root.chosen(option.view, option.id); }
                }
              }
            }
          }
        }
      }
    }

    if root.mode == WindowMode.diagnostic: VerticalLayout {
      // The prompt side's frame, restated here because it is the same frame:
      // the two modes are two panes of one window, not two windows.
      padding: 18px;
      spacing: 18px;

      // The same header as the prompt's, down to the inset arithmetic. The
      // standing schedule sits under the title exactly where a view's body
      // sits under its question: it is the context for what is in the report,
      // not a row of it — which is what `next-check` has always been (see the
      // property's own comment).
      Card {
        VerticalLayout {
          padding-left: root.card-inset + root.panel-inset;
          padding-right: root.card-inset + root.panel-inset;
          padding-top: root.card-inset;
          padding-bottom: root.card-inset;
          spacing: 4px;

          Text {
            text: "Diagnostics";
            font-size: 17px;
            font-weight: 600;
          }

          if root.next-check != "": Text {
            text: root.next-check;
            wrap: word-wrap;
            color: Palette.foreground.transparentize(0.35);
          }
        }
      }

      // **One card for the whole report, not one per line.** The prompt side
      // cards an *option* because an option is a thing a person answers; a
      // diagnostic line is not. The lines are one body of text, and a frame
      // each would put a dozen of them on a pane that has one thing to say.
      Card {
        VerticalLayout {
          padding: root.card-inset;

          // **The report sits in a panel, as a block of fields does.** Card
          // inset plus panel inset is the same arithmetic the header's padding
          // uses, so a diagnostic line, a checkbox label and the pane's title
          // all begin in one column — and the text a person reads sits on the
          // top tone in both panes, rather than on the panel in one and the
          // card in the other.
          Panel {
            VerticalLayout {
              padding: root.panel-inset;
              spacing: 4px;
              alignment: start;

              // Outside the list below, deliberately: inside, it would be one
              // more `Text` in a scope whose item count states how many
              // diagnostics there are. It is selected by its own text
              // (`wiring.rs::nothing_to_report_shown`), which a `Text` exposes
              // as its accessible label without being asked.
              if root.diagnostic-lines.length == 0: Text {
                text: "Nothing to report.";
                color: Palette.foreground.transparentize(0.35);
              }

              // **Unconditional**, and not guarded on the line count. This is
              // the element `wiring.rs::in_diagnostic_mode` finds to decide
              // which pane is up; guarding it would make an empty report look
              // like the prompt pane to every test that asks.
              lines := ScrollView {
                // **A diagnostic line wraps rather than running off the edge.**
                //
                // `wrap` alone does nothing here. A `ScrollView` gives its
                // content an unconstrained width, and a `Text` reports its
                // whole string as its preferred width, so the line was laid out
                // at full length and the pane scrolled sideways to it. Pinning
                // the layout to the scroller's *visible* width is what gives
                // the wrap something to wrap against; the horizontal bar then
                // has nothing to scroll and is turned off rather than left
                // sitting there disabled.
                //
                // This is the prompt side's sizing defect in the other
                // direction: there, nothing propagated a width upward out of a
                // scroller; here, nothing propagated one downward into it.
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                  width: lines.visible-width;

                  accessible-role: list;
                  accessible-label: "diagnostics";
                  accessible-item-count: root.diagnostic-lines.length;

                  // Pack to the top, for the reason already settled on the
                  // prompt side (L-2): without it the list hands each line an
                  // equal share of the pane's height, so two diagnostics sat
                  // one at the top and one in the middle, with a void between.
                  alignment: start;

                  for line[index] in root.diagnostic-lines: Text {
                    text: line;
                    wrap: word-wrap;
                    accessible-item-index: index;
                  }
                }
              }
            }
          }
        }
      }

      // At the foot of what it dismisses and not stretched across it — the
      // same treatment every control on the prompt side gets, and for the same
      // reason: a full-width button reads as a banner rather than as the thing
      // you press.
      HorizontalLayout {
        alignment: start;
        Button {
          text: "Close";
          accessible-description: "close-diagnostics";
          clicked => { root.close-diagnostics(); }
        }
      }
    }

    if root.notice != "": Text { text: root.notice; }
  }
}

export component Tray inherits SystemTrayIcon {
  // `icon`, `tooltip` and `visible` are SystemTrayIcon's own. They cannot be
  // redeclared ("Cannot override property") **and** inheriting them exposes no
  // Rust setter, so the values the glass must write get their own properties
  // and the builtins are *bound* to them. Binding is also what stops the
  // compiler folding `visible` into a constant — E-4's panic trap, closed by
  // measurement rather than by belief (F-28).
  in property <image> image;
  in property <string> hover-text;
  in property <bool> shown: true;

  icon: root.image;
  tooltip: root.hover-text;
  visible: root.shown;

  callback check-now();
  callback show-diagnostics();
  callback quit();

  // Magnification, proved out from the tray before it is worth spending
  // anything on a key binding. The tray is the one surface that needs neither
  // — a `Ctrl +/-` needs something focused to bubble from, and keyboard focus
  // does not survive a present (007 follow-up); a `Ctrl`+wheel has to be taken
  // off the `ScrollView`, whose `Flickable` accepts every wheel event with no
  // modifier check at all. Neither is a rider on this.
  //
  // `MenuItem` has a `shortcut` property, which would sidestep the focus
  // problem entirely — menubar shortcuts are matched before the event reaches
  // the focused item — but it is only honoured inside a `MenuBar`, and this is
  // a `SystemTrayIcon`'s menu.
  callback zoom-in();
  callback zoom-out();
  callback zoom-reset();

  Menu {
    MenuItem { title: "Check now";   activated => { root.check-now(); } }
    MenuItem { title: "Diagnostics"; activated => { root.show-diagnostics(); } }
    MenuSeparator { }
    MenuItem { title: "Zoom in";     activated => { root.zoom-in(); } }
    MenuItem { title: "Zoom out";    activated => { root.zoom-out(); } }
    MenuItem { title: "Reset zoom";  activated => { root.zoom-reset(); } }
    MenuSeparator { }
    MenuItem { title: "Quit";        activated => { root.quit(); } }
  }
}
