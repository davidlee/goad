# `*.local.*` — scratch files that stay out of the repository: review packets,
# probes, capsules. The user's global ignore file covers this too, but the rule
# belongs here as well so a clean clone on another machine behaves the same.
*.local.*

target/

# agent worktrees, never committed
.claude/worktrees/

# the demo's ingress socket — lives in the checkout deliberately (D-17);
# examples/demo.toml's [ingress] path resolves against the repository root,
# which `just` sets as goad's working directory
/goad-demo.sock
