# `*.local.*` — scratch files that stay out of the repository: review packets,
# probes, capsules. The user's global ignore file covers this too, but the rule
# belongs here as well so a clean clone on another machine behaves the same.
*.local.*

target/

# agent worktrees, never committed
.claude/worktrees/

# the demo's ingress socket, and the lock file the host holds beside it —
# both live in the checkout deliberately (D-17); exercisers/demo.toml's
# [ingress] path resolves against that file's directory (SPEC-003/R-17), so
# they sit in exercisers/ wherever goad is started from. The host unlinks
# neither on exit (`SPEC-003/R-5`).
/exercisers/goad-demo.sock
/exercisers/goad-demo.sock.lock

# the socket an event-driven kit example's host binds in the example's own
# directory, and its lock file — the same arrangement as the demo's (D-17):
# each config's [ingress] path is ./goad.sock, which resolves against the
# config's own directory (SPEC-003/R-17).
/kit/skills/goad-backend/examples/*/goad.sock
/kit/skills/goad-backend/examples/*/goad.sock.lock

# nix build out-links. `result` alone is covered by the user's global ignore
# file on this machine; the rule belongs here as well, and covers the numbered
# and named forms a multi-package build produces (`just package` uses
# `--no-link` and needs none of this, but a bare `nix build` does).
/result
/result-*
