import { CheckBox, LineEdit, Slider, ComboBox, Button, Palette, ScrollView,
         DatePickerPopup, TimePickerPopup, Date, Time } from "std-widgets.slint";

// U-2: one enum + one fat struct, so every kind sits in one repeater and
// declaration order is preserved.
export enum Kind { boolean, text, number, choice, datetime }

export struct FieldRow {
    id: string,
    label: string,
    kind: Kind,
    checked: bool,
    text: string,
    number: float,
    minimum: float,
    maximum: float,
    alternatives: [string],
}

export component Spike inherits Window {
    title: "spike: field kinds";
    preferred-width: 520px;
    preferred-height: 620px;

    in property <[FieldRow]> fields;
    // U-1: bumped by the host on every present, so a re-assert can be
    // triggered even when this row's own data did not change.
    in property <int> epoch;
    in property <string> log;
    // Instrument: an element that is destroyed and recreated runs `init`
    // again. A re-assert is counted only when the guard actually fired.
    in-out property <int> inits;
    in-out property <int> reasserts;
    // Distinguishes "the handler never ran" from "the guard found agreement".
    in-out property <int> fires;
    // Control: `changed` at the root, no repeater in the way.
    in-out property <int> probe;
    in-out property <int> root-changes;
    changed probe => { root.root-changes += 1; }

    // U-3: does a callback hand a whole struct back to Rust?
    callback edited(FieldRow);
    callback present-row-data();
    callback present-set-vec();
    callback diverge();
    callback open-picker();
    in-out property <string> picking;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text { text: "epoch " + root.epoch + " | inits " + root.inits + " | fires " + root.fires + " | reasserts " + root.reasserts + " | root-changes " + root.root-changes; font-size: 11px; }

        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 10px;

                for field[i] in root.fields: VerticalLayout {
                    spacing: 2px;
                    alignment: start;

                    if field.kind != Kind.boolean: Text {
                        text: field.label;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.35);
                    }

                    if field.kind == Kind.boolean: HorizontalLayout {
                        alignment: start;
                        cb := CheckBox {
                            text: field.label;
                            checked: field.checked;
                            // U-1: guarded re-assert.
                            init => { root.inits += 1; }
                            property <int> tick: root.epoch;
                            changed tick => {
                                root.fires += 1;
                                if (self.checked != field.checked) {
                                    self.checked = field.checked;
                                    root.reasserts += 1;
                                }
                            }
                            toggled => {
                                root.edited({ id: field.id, kind: field.kind, checked: self.checked });
                            }
                        }
                    }

                    if field.kind == Kind.text: LineEdit {
                        text: field.text;
                        init => { root.inits += 1; }
                        property <int> tick: root.epoch;
                        changed tick => {
                            root.fires += 1;
                            if (self.text != field.text) {
                                self.text = field.text;
                                root.reasserts += 1;
                            }
                        }
                        edited(t) => {
                            root.edited({ id: field.id, kind: field.kind, text: t });
                        }
                    }

                    if field.kind == Kind.number: HorizontalLayout {
                        spacing: 8px;
                        sl := Slider {
                            minimum: field.minimum;
                            maximum: field.maximum;
                            value: field.number;
                            init => { root.inits += 1; }
                            property <int> tick: root.epoch;
                            changed tick => {
                                root.fires += 1;
                                if (self.value != field.number) {
                                    self.value = field.number;
                                    root.reasserts += 1;
                                }
                            }
                            changed(v) => {
                                root.edited({ id: field.id, kind: field.kind, number: v });
                            }
                        }
                        Text { text: Math.round(sl.value); vertical-alignment: center; width: 40px; }
                    }

                    if field.kind == Kind.choice: HorizontalLayout {
                        alignment: start;
                        ComboBox {
                            model: field.alternatives;
                            current-value: field.text;
                            init => { root.inits += 1; }
                            property <int> tick: root.epoch;
                            changed tick => {
                                root.fires += 1;
                                if (self.current-value != field.text) {
                                    self.current-value = field.text;
                                    root.reasserts += 1;
                                }
                            }
                            selected(v) => {
                                root.edited({ id: field.id, kind: field.kind, text: v });
                            }
                        }
                    }

                    // U-4: the pickers are popups, so the inline control is a
                    // button showing the value.
                    // U-4: a PopupWindow cannot be repeated or conditional,
                    // so the picker is a single root instance and the row only
                    // records which field opened it.
                    if field.kind == Kind.datetime: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: field.text == "" ? "Pick a date…" : field.text;
                            clicked => {
                                root.picking = field.id;
                                root.open-picker();
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button { text: "present (set_row_data)"; clicked => { root.present-row-data(); } }
            Button { text: "present (set_vec)"; clicked => { root.present-set-vec(); } }
            Button { text: "diverge + present"; clicked => { root.diverge(); } }
        }

        Text { text: root.log; font-size: 11px; wrap: word-wrap; }
    }

    picker := DatePickerPopup {
        accepted(d) => {
            root.edited({ id: root.picking, kind: Kind.datetime,
                          text: d.year + "-" + d.month + "-" + d.day });
        }
    }
    open-picker => { picker.show(); }
}

// ── The split channel (slice 009, D-9) ────────────────────────────────────
//
// Structure and value travel on two properties, not one. `rows` is repeated
// over and is written only when the view changes; `values` is indexed by the
// slot each row carries and is rewritten wholesale on every present. Nothing
// repeats over `values`, so rewriting it should destroy no element.
//
// The question: does `root.values[field.slot]` compile, and does it track?

export struct SlotRow { id: string, label: string, kind: Kind, slot: int }
export struct FieldValue { checked: bool, text: string, number: float }

export component Split inherits Window {
    in property <[SlotRow]> rows;
    in property <[FieldValue]> values;
    in property <int> epoch;

    in-out property <int> inits;
    in-out property <int> fires;
    in-out property <int> reasserts;

    callback edited(string, bool);

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text { text: "inits " + root.inits + " | fires " + root.fires + " | reasserts " + root.reasserts; }

        for field in root.rows: HorizontalLayout {
            alignment: start;
            if field.kind == Kind.boolean: CheckBox {
                text: field.label;
                // The binding a click destroys — now reading the flat model.
                checked: root.values[field.slot].checked;
                init => { root.inits += 1; }
                property <int> tick: root.epoch;
                changed tick => {
                    root.fires += 1;
                    if (self.checked != root.values[field.slot].checked) {
                        self.checked = root.values[field.slot].checked;
                        root.reasserts += 1;
                    }
                }
                toggled => { root.edited(field.id, self.checked); }
            }
            // A number with no bounds, or one bound: a numeric LineEdit, and
            // a guard that compares what the text *parses to* rather than the
            // text. A person clearing the field to retype must not be fought.
            if field.kind == Kind.number: LineEdit {
                input-type: InputType.decimal;
                text: root.values[field.slot].number;
                init => { root.inits += 1; }
                property <int> tick: root.epoch;
                changed tick => {
                    root.fires += 1;
                    if (self.text.to-float() != root.values[field.slot].number) {
                        self.text = root.values[field.slot].number;
                        root.reasserts += 1;
                    }
                }
                edited(t) => { root.edited(field.id, true); }
            }
            if field.kind == Kind.text: LineEdit {
                text: root.values[field.slot].text;
                init => { root.inits += 1; }
                property <int> tick: root.epoch;
                changed tick => {
                    root.fires += 1;
                    if (self.text != root.values[field.slot].text) {
                        self.text = root.values[field.slot].text;
                        root.reasserts += 1;
                    }
                }
                edited(t) => { root.edited(field.id, true); }
            }
        }
    }
}
